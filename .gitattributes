# Keep the signed updater trust anchor byte-identical on Windows.
/companion/engine/public-key.pem text eol=lf

# Reproducible worker archive and generated board bytes across checkouts.
/worker/** text eol=lf
/UNFINISHED-WORK/owner-progress-20261029.* text eol=lf
/public/owner-progress.html text eol=lf

# Preserve captured execution bytes, including intentionally failed output.
/UNFINISHED-WORK/evidence/backpack-readiness-20261030/** -text
/UNFINISHED-WORK/evidence/backpack-readiness-20261030/**/*.log -diff
/UNFINISHED-WORK/evidence/backpack-readiness-20261030/*.txt -diff
/UNFINISHED-WORK/evidence/backpack-readiness-20261030/** whitespace=trailing-space,space-before-tab,cr-at-eol

# Preserve the other agent's captured failures and full execution receipts.
/UNFINISHED-WORK/evidence/resumption-20261030/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/UNFINISHED-WORK/evidence/resumption-20261030/**/*.log -diff
/UNFINISHED-WORK/evidence/resumption-20261030/*.log -diff

# Preserve November 1 executed receipts exactly, including native CRLF output.
/UNFINISHED-WORK/evidence/durable-completion-20261101/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/UNFINISHED-WORK/evidence/durable-completion-20261101/*.log -diff

# Exact source-safety regression outputs, including failed baselines.
/UNFINISHED-WORK/evidence/safety-reconciliation-20261101/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/UNFINISHED-WORK/evidence/safety-reconciliation-20261101/*.txt -diff

# Nested raw captures are binary diffs; preserve their exact whitespace/bytes.
/UNFINISHED-WORK/evidence/safety-reconciliation-20261101/**/*.log -diff
/UNFINISHED-WORK/evidence/safety-reconciliation-20261101/*.log -diff

/UNFINISHED-WORK/evidence/native-completion-20261101/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/UNFINISHED-WORK/evidence/native-completion-20261101/**/*.log -diff
/UNFINISHED-WORK/evidence/native-completion-20261101/*.txt -diff

# Portable native context host scripts and contracts.
/scripts/native-backpack-context.mjs text eol=lf
/scripts/run-native-with-backpack.mjs text eol=lf
/tests/native-backpack-context.test.mjs text eol=lf
