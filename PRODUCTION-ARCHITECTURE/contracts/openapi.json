  "components": {
    "securitySchemes": {
      "sessionBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Operation": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "accepted",
              "dispatched",
              "reconciling",
              "succeeded",
              "failed",
              "compensated",
              "canceled"
            ]
          },
          "status_url": {
            "type": "string"
          },
          "provider_receipt_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "required": [
          "operation_id",
          "revision",
          "state",
          "status_url"
        ],
        "additionalProperties": false
      },
      "RunCreate": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          },
          "task_class": {
            "enum": [
              "development",
              "repair",
              "research",
              "security",
              "simulation",
              "innovation"
            ]
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 50
          },
          "requested_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          },
          "execution_policy": {
            "type": "object",
            "properties": {
              "max_agent_turns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "max_concurrency": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "deadline": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "max_agent_turns",
              "max_concurrency",
              "deadline"
            ],
            "additionalProperties": false
          },
          "budget": {
            "type": "object",
            "properties": {
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "maximum_micro": {
                "type": "string",
                "pattern": "^[0-9]{1,20}$"
              }
            },
            "required": [
              "currency",
              "maximum_micro"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "objective",
          "snapshot_id",
          "task_class",
          "acceptance_criteria",
          "requested_capabilities",
          "execution_policy",
          "budget"
        ],
        "additionalProperties": false
      },
      "ChangeSetCreate": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "base_snapshot_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "artifact_manifest_id": {
            "type": "string",
            "format": "uuid"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1
          },
          "summary": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "required": [
          "run_id",
          "base_snapshot_digest",
          "artifact_manifest_id",
          "evidence_ids",
          "summary"
        ],
        "additionalProperties": false
      },
      "DeploymentRequest": {
        "type": "object",
        "properties": {
          "change_set_id": {
            "type": "string",
            "format": "uuid"
          },
          "target_ref": {
            "type": "string",
            "minLength": 1
          },
          "plan_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "approval_id": {
            "type": "string",
            "format": "uuid"
          },
          "rollback_artifact_id": {
            "type": "string",
            "format": "uuid"
          },
          "health_gate_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "change_set_id",
          "target_ref",
          "plan_digest",
          "approval_id",
          "rollback_artifact_id",
          "health_gate_id"
        ],
        "additionalProperties": false
      },
      "GraphQuery": {
        "type": "object",
        "properties": {
          "operation": {
            "enum": [
              "neighborhood",
              "dependency_path",
              "impact",
              "entity_search"
            ]
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 100
          },
          "snapshot_ref": {
            "type": "string"
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "node_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "edge_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [
          "operation",
          "snapshot_ref",
          "depth",
          "node_limit",
          "edge_limit"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          },
          "retry_after_ms": {
            "type": "integer",
            "minimum": 0
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
