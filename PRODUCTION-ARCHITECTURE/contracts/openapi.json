              }
            }
          },
          "200": {
            "description": "Authorized bounded graph result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "snapshot_ref": {
                      "type": "string"
                    },
                    "watermark": {
                      "type": "string"
                    },
                    "partial": {
                      "type": "boolean"
                    },
                    "nodes": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "maxItems": 1000
                    },
                    "edges": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "maxItems": 5000
                    },
                    "cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "snapshot_ref",
                    "watermark",
                    "partial",
                    "nodes",
                    "edges"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
