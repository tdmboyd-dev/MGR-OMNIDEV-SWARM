{
  "schema": "mgr.trilogy.local-integration.v1",
  "passed": true,
  "checks": [
    "actual imported project and native candidate reach review",
    "owner authorization binds exact source, plan and command",
    "live viewer reads the actual authorized job before candidate staging",
    "actual staged Git candidate flows through OmniDev into the read-only viewer",
    "real candidate snapshot test output is admitted by Code Monster",
    "OmniDev refuses altered runner output without upgrading its saved job",
    "live full-scope view shows exact pending-owner proof; scoped view withholds it",
    "producer restart replays the same candidate and five durable events",
    "changed project source and actual owner revocation remove access without cached evidence",
    "candidate work never changes source HEAD or source worktree"
  ],
